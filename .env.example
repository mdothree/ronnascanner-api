# ronnascanner-api: backend environment variables (names only; values live in the
# Vercel project env, NEVER in git). /health reports which groups are set (booleans).

# Firebase Admin service account for project mdo3d-leads (mdothree@gmail)
FIREBASE_PROJECT_ID=mdo3d-leads
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (MDO3 account). Deploy with sk_test_ / whsec_ from TEST mode first.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated price ids. Only these can be bought or granted.
STRIPE_PRO_PRICE_IDS=
STRIPE_TEAM_PRICE_IDS=

# Data providers (paid plans with API access)
APOLLO_API_KEY=
HUNTER_API_KEY=

# Optional: require Firebase App Check tokens (default off)
APPCHECK_ENFORCE=false
