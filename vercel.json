{
  "version": 2,
  "builds": [
    {
      "src": "api/{payment,leads,emails,meta}/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/(api/)?health", "dest": "/api/meta/index.js?op=health" },
    { "src": "/api/payment/webhook", "dest": "/api/payment/webhook.js" },
    { "src": "/api/payment/create-session", "dest": "/api/payment/create-session.js" },
    { "src": "/api/payment/create-embedded-session", "dest": "/api/payment/create-embedded-session.js" },
    { "src": "/api/payment/portal", "dest": "/api/payment/portal.js" },
    { "src": "/api/leads/scan", "dest": "/api/leads/scan.js" },
    { "src": "/api/emails/find", "dest": "/api/emails/find.js" },
    { "src": "/api/contacts/find", "dest": "/api/meta/index.js?op=stub&tool=contacts" },
    { "src": "/api/companies/scan", "dest": "/api/meta/index.js?op=stub&tool=companies" },
    { "src": "/api/prospects/research", "dest": "/api/meta/index.js?op=stub&tool=prospects" },
    { "src": "/(.*)", "dest": "/api/meta/index.js?op=notfound" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
